# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asset_management
DB_USER=postgres
DB_PASSWORD=changeme

# LDAP
LDAP_URL=ldap://your-ad-server:389
LDAP_BASE_DN=dc=company,dc=com
LDAP_BIND_DN=cn=service-account,ou=service,dc=company,dc=com
LDAP_BIND_PASSWORD=changeme
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=company,dc=com

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Backend
BACKEND_PORT=3001
BACKEND_CORS_ORIGIN=http://localhost:3000

# Admin API
ADMIN_API_PORT=3002
ADMIN_CORS_ORIGIN=http://localhost:3003

# Redis (for session/cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=/tmp/uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
